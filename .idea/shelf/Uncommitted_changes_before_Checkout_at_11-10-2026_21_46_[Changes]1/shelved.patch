<+>#lms\r\nprint(\"library management system\")\r\nprint(\"lms of iiit dwd\")\r\nprint(\"pycharm is very useful for python projects\")\r\nfrom member import Member\r\nfrom library import  Library\r\n\r\n\r\ndef main():\r\n    library = Library()\r\n\r\n    # Load books from the data file\r\n    library.load_books(\"data/books.txt\")\r\n\r\n    # Create members\r\n    member1 = Member(1, \"Rahul\")\r\n    member2 = Member(2, \"Priya\")\r\n\r\n    library.add_member(member1)\r\n    library.add_member(member2)\r\n\r\n    print(\"BOOKS\")\r\n    print(\"-----------------------------\")\r\n    library.show_books()\r\n\r\n    print(\"\\nIssuing book...\")\r\n    library.issue_book(101, 1)\r\n\r\n    print(\"\\nBOOKS AFTER ISSUE\")\r\n    print(\"-----------------------------\")\r\n    library.show_books()\r\n\r\n    print(\"\\nReturning book...\")\r\n    library.return_book(101, 1)\r\n\r\n    print(\"\\nBOOKS AFTER RETURN\")\r\n    print(\"-----------------------------\")\r\n    library.show_books()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n
